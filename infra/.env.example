# Variáveis de ambiente — CEMAN Automação
# Copie este arquivo para .env e preencha os valores antes de executar o projeto.
# NUNCA versione o arquivo .env com dados reais.

# --- Credenciais do Portal CEMAN ---
CEMAN_URL=https://ceman.tjdft.jus.br
CEMAN_USUARIO=seu_usuario
CEMAN_SENHA=sua_senha

# --- API Gemini (Google AI) ---
GEMINI_API_KEY=sua_chave_gemini

# --- API Backend ---
# Origens CORS permitidas (separadas por vírgula). Ex.: http://apex.tjdft.jus.br
ALLOWED_ORIGINS=http://localhost
APEX_BASE_URL=https://apex.tjdft.jus.br/ords/ceman/api

# --- n8n ---
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_USER=admin
N8N_PASSWORD=sua_senha_n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ceman
N8N_WEBHOOK_EXTERNAL_URL=http://localhost:5678

# --- Evolution API ---
EVOLUTION_API_KEY=sua_chave_evolution

# --- Scraper ---
DOWNLOAD_DIR=/tmp/mandados
